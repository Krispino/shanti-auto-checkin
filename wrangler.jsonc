{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Domínio próprio para os hóspedes. O workers.dev segue ativo porque
  // links antigos já enviados a hóspedes ainda apontam para ele.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "checkin.shantipousada.com.br", "custom_domain": true }
  ]
}
